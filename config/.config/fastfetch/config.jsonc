{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty",
    "source": "~/.config/fastfetch/logo/archlinuxlogo.png",
    "height": 20,
    "padding": { "left": 4, "right": 4 },
  },
  "display": {
    "separator": "  ",
    "color": "default",
  },

  "modules": [
    {
      "type": "title",
      "key": " User",
      "keyColor": "#F2CDCD",
      "format": "{1}",
    },
    {
      "type": "custom",
      "format": "✦ ────────────────⋆｡° ☽ ✩ ☾ °｡⋆──────────────── ✦ ",
    },
    {
      "type": "kernel",
      "key": " Kernel",
      "keyColor": "#F4C7B5",
    },
    {
      "type": "os",
      "key": "󰣇 OS",
      "keyColor": "#F5D6B3",
    },
    {
      "type": "host",
      "key": "󰌢 Host",
      "keyColor": "#F2E2B3",
      "format": "{2}",
    },
    {
      "type": "packages",
      "key": "󰏖 Packages",
      "keyColor": "#DDE5B6",
    },
    {
      "type": "shell",
      "key": " Shell",
      "keyColor": "#CDE7BE",
    },
    {
      "type": "de",
      "key": " DE",
      "keyColor": "#BFE7C6",
      "format": "{1} {version}",
    },
    {
      "type": "terminal",
      "key": " Terminal",
      "keyColor": "#B8E7D3",
    },
    {
      "type": "cpu",
      "key": " CPU",
      "keyColor": "#B8E4E8",
      "format": "{1}",
    },
    {
      "type": "gpu",
      "key": "󰢮 GPU",
      "keyColor": "#BFDDF6",
      "format": "{1} {2} @ {12}",
    },
    {
      "type": "memory",
      "key": " Memory",
      "keyColor": "#C9D5F5",
    },
    {
      "type": "swap",
      "key": "󰓡 Swap",
      "keyColor": "#D6CCF5",
    },
    {
      "type": "disk",
      "key": " Disk",
      "keyColor": "#E2C7F4",
    },
    {
      "type": "uptime",
      "key": "󰔛 Uptime",
      "keyColor": "#EDC4E8",
    },
    {
      "type": "datetime",
      "key": "󰃭 Date",
      "keyColor": "#F2C3DA",
      "format": "{3}/{11}/{1} - {14}:{18} {22}",
    },
    {
      "type": "command",
      "shell": "/bin/bash",
      "text": "$HOME/.config/fastfetch/last_update.sh",
      "key": "󰚰 Updated",
      "keyColor": "#F4D0E1",
    },
    {
      "type": "custom",
      "format": "✦ ────────────────⋆｡° ☽ ✩ ☾ °｡⋆──────────────── ✦ ",
    },
    {
      "type": "colors",
      "paddingLeft": 17,
      "symbol": "star",
    },
    "break",
  ],
}
